{
  "version": 2,
  "builds": [
    {
      "src": "multibiz/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "templates/**",
          "app/templates/**",
          "static/**"
        ],
        "excludeFiles": [
          "public_html (1)/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "multibiz/wsgi.py"
    }
  ]
}
